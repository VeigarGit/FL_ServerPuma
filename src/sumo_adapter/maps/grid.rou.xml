<?xml version="1.0" encoding="UTF-8"?>
<!--
  Routes for the 3x3 grid network generated by netgenerate.
  Grid layout (200m spacing):
  
    A0 ── A1 ── A2
    |     |     |
    B0 ── B1 ── B2    (B1 = center)
    |     |     |
    C0 ── C1 ── C2

  Vehicles converge at B1 (center) around t=15-25s.
  IMPORTANT: Sorted by depart time (SUMO requirement).
-->
<routes>
    <!-- depart=0.0 -->
    <vehicle id="veh_0" depart="0.0" color="1,0,0">
        <route edges="C0C1 C1B1 B1A1 A1A2"/>
    </vehicle>

    <vehicle id="veh_3" depart="0.0" color="1,1,0">
        <route edges="C0B0 B0B1 B1B2 B2A2"/>
    </vehicle>

    <!-- depart=2.0 -->
    <vehicle id="veh_1" depart="2.0" color="0,1,0">
        <route edges="A0A1 A1B1 B1C1 C1C2"/>
    </vehicle>

    <!-- depart=5.0 -->
    <vehicle id="veh_2" depart="5.0" color="0,0,1">
        <route edges="A2A1 A1B1 B1C1 C1C0"/>
    </vehicle>

    <!-- depart=10.0 -->
    <vehicle id="veh_4" depart="10.0" color="1,0,1">
        <route edges="C2C1 C1B1 B1A1 A1A0"/>
    </vehicle>
</routes>
